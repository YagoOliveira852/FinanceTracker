# Segredos do backup (deploy/backup.sh): copie para a pasta do servidor, ao
# lado do compose.prod.yml, como `restic.env`, com `chmod 600`, e preencha lá.
# Nunca commite o restic.env real. Só o container restic lê este arquivo; a
# api não (ver compose.prod.yml).

# Repositório restic no bucket do B2, pela API S3 (a recomendada pelo restic).
# O endpoint aparece na página do bucket ("Endpoint", s3.<região>.backblazeb2.com).
RESTIC_REPOSITORY=s3:https://<endpoint-s3-do-b2>/<bucket>

# Cifra o repositório. Sem ela os backups são ilegíveis e não há recuperação:
# guarde uma cópia no gerenciador de senhas no mesmo momento. Gere com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RESTIC_PASSWORD=

# Application key do B2, restrita ao bucket (keyID e applicationKey).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Opcional: URL de ping do check no healthchecks.io. Sem ela, o backup roda
# igual e só não avisa.
BACKUP_PING_URL=
