# .env de produção: copie para a pasta do servidor, ao lado do compose.prod.yml,
# como `.env`, e troque os valores. Nunca commite o .env real.
# Serve ao compose (POSTGRES_PASSWORD, TAG) e à api (env_file).

# Senha do Postgres. Também entra na DATABASE_URL que o compose monta, então
# use só caracteres seguros em URL; gere com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=troque-esta-senha

# Assina os access tokens (JWT). 32+ caracteres aleatórios; gere com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais

# Opcionais; os valores abaixo são os padrões.
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=30
TZ_NEGOCIO=America/Fortaleza

# Versão da imagem da api. Sem TAG, usa latest (último push na main).
# TAG=sha-1a2b3c4
