{
  "openapi": "3.1.0",
  "info": {
    "title": "Finanças pessoais",
    "version": "0.1.0"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Troca e-mail e senha por um access token (curto) e um refresh token (longo).",
        "operationId": "auth_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tokens"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh",
        "description": "Troca o refresh token por um par novo; o token enviado deixa de valer.",
        "operationId": "auth_refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tokens"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/eu": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Eu",
        "description": "Usuário dono do access token enviado.",
        "operationId": "auth_eu",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioSaida"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/contas": {
      "get": {
        "tags": [
          "contas"
        ],
        "summary": "Listar",
        "description": "Todas as contas com o saldo atual, e o total disponível (correntes e carteiras).\nCartões trazem também a fatura atual.",
        "operationId": "contas_listar",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContasResumo"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "contas"
        ],
        "summary": "Criar",
        "description": "Cadastra uma conta corrente ou a carteira (dinheiro em espécie).",
        "operationId": "contas_criar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContaEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContaSaida"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/contas/{conta_id}": {
      "get": {
        "tags": [
          "contas"
        ],
        "summary": "Obter",
        "operationId": "contas_obter",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "conta_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Conta Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContaSaida"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transacoes": {
      "post": {
        "tags": [
          "transacoes"
        ],
        "summary": "Lancar",
        "description": "Lançamento manual de despesa ou receita, já confirmado.",
        "operationId": "transacoes_lancar",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransacaoEntrada"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransacaoSaida"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "transacoes"
        ],
        "summary": "Listar",
        "description": "Transações (todos os status), da mais recente para a mais antiga.\n\n`de` e `ate` são inclusivos; para um mês, use o primeiro e o último dia dele.",
        "operationId": "transacoes_listar",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "conta_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Conta Id"
            }
          },
          {
            "name": "de",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "De"
            }
          },
          {
            "name": "ate",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransacaoSaida"
                  },
                  "title": "Response Transacoes Listar"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transacoes/{transacao_id}": {
      "get": {
        "tags": [
          "transacoes"
        ],
        "summary": "Obter",
        "operationId": "transacoes_obter",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "transacao_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Transacao Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransacaoSaida"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cartoes": {
      "post": {
        "tags": [
          "cartoes"
        ],
        "summary": "Criar",
        "description": "Cadastra um cartão de crédito: a conta e os dados do cartão.",
        "operationId": "cartoes_criar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CartaoEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContaSaida"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/cartoes/previa": {
      "get": {
        "tags": [
          "cartoes"
        ],
        "summary": "Previa",
        "description": "Próxima fatura (a de uma compra feita hoje) para dias ainda não salvos.",
        "operationId": "cartoes_previa",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "dia_fechamento",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 31,
              "minimum": 1,
              "title": "Dia Fechamento"
            }
          },
          {
            "name": "dia_vencimento",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 31,
              "minimum": 1,
              "title": "Dia Vencimento"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasFaturaSaida"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/saude": {
      "get": {
        "tags": [
          "saude"
        ],
        "summary": "Saude",
        "description": "Responde se a API está no ar e consegue falar com o banco.",
        "operationId": "saude_saude",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saude"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaErro"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CartaoEntrada": {
        "properties": {
          "nome": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Nome"
          },
          "instituicao": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Instituicao",
            "description": "Nome da instituição. Se nenhuma tiver esse nome (sem diferenciar maiúsculas), uma nova é criada."
          },
          "conta_pagamento_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conta Pagamento Id",
            "description": "Conta corrente ativa que paga a fatura."
          },
          "dia_fechamento": {
            "type": "integer",
            "maximum": 31.0,
            "minimum": 1.0,
            "title": "Dia Fechamento",
            "description": "31 vira o último dia do mês."
          },
          "dia_vencimento": {
            "type": "integer",
            "maximum": 31.0,
            "minimum": 1.0,
            "title": "Dia Vencimento",
            "description": "Diferente do fechamento; 31 vira o último dia do mês."
          },
          "limite": {
            "anyOf": [
              {
                "type": "string",
                "format": "decimal"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limite"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nome",
          "instituicao",
          "conta_pagamento_id",
          "dia_fechamento",
          "dia_vencimento"
        ],
        "title": "CartaoEntrada"
      },
      "CartaoSaida": {
        "properties": {
          "conta_pagamento_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conta Pagamento Id"
          },
          "dia_fechamento": {
            "type": "integer",
            "title": "Dia Fechamento"
          },
          "dia_vencimento": {
            "type": "integer",
            "title": "Dia Vencimento"
          },
          "limite": {
            "anyOf": [
              {
                "type": "string",
                "format": "decimal"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limite"
          },
          "fatura_atual": {
            "$ref": "#/components/schemas/FaturaResumo",
            "description": "A fatura de uma compra feita hoje."
          }
        },
        "type": "object",
        "required": [
          "conta_pagamento_id",
          "dia_fechamento",
          "dia_vencimento",
          "limite",
          "fatura_atual"
        ],
        "title": "CartaoSaida"
      },
      "ContaEntrada": {
        "properties": {
          "nome": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Nome"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "corrente",
              "carteira"
            ],
            "title": "Tipo"
          },
          "instituicao": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Instituicao",
            "description": "Nome da instituição. Obrigatório na conta corrente e ausente na carteira. Se nenhuma instituição tiver esse nome (sem diferenciar maiúsculas), uma nova é criada."
          },
          "saldo_inicial": {
            "type": "string",
            "format": "decimal",
            "title": "Saldo Inicial",
            "description": "Saldo no começo do dia `data_saldo_inicial`."
          },
          "data_saldo_inicial": {
            "type": "string",
            "format": "date",
            "title": "Data Saldo Inicial",
            "description": "Não pode ser depois de hoje."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nome",
          "tipo",
          "saldo_inicial",
          "data_saldo_inicial"
        ],
        "title": "ContaEntrada"
      },
      "ContaSaida": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "nome": {
            "type": "string",
            "title": "Nome"
          },
          "tipo": {
            "$ref": "#/components/schemas/TipoConta"
          },
          "instituicao": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InstituicaoSaida"
              },
              {
                "type": "null"
              }
            ]
          },
          "saldo_inicial": {
            "type": "string",
            "format": "decimal",
            "title": "Saldo Inicial"
          },
          "data_saldo_inicial": {
            "type": "string",
            "format": "date",
            "title": "Data Saldo Inicial"
          },
          "saldo_atual": {
            "type": "string",
            "format": "decimal",
            "title": "Saldo Atual",
            "description": "`saldo_inicial` mais as transações confirmadas com data a partir de `data_saldo_inicial`."
          },
          "ativa": {
            "type": "boolean",
            "title": "Ativa"
          },
          "cartao": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CartaoSaida"
              },
              {
                "type": "null"
              }
            ],
            "description": "Dados do cartão; nulo se não for cartão."
          }
        },
        "type": "object",
        "required": [
          "id",
          "nome",
          "tipo",
          "instituicao",
          "saldo_inicial",
          "data_saldo_inicial",
          "saldo_atual",
          "ativa",
          "cartao"
        ],
        "title": "ContaSaida"
      },
      "ContasResumo": {
        "properties": {
          "total_disponivel": {
            "type": "string",
            "format": "decimal",
            "title": "Total Disponivel",
            "description": "Soma dos saldos das contas correntes e carteiras ativas; cartão não entra."
          },
          "contas": {
            "items": {
              "$ref": "#/components/schemas/ContaSaida"
            },
            "type": "array",
            "title": "Contas"
          }
        },
        "type": "object",
        "required": [
          "total_disponivel",
          "contas"
        ],
        "title": "ContasResumo"
      },
      "DatasFaturaSaida": {
        "properties": {
          "competencia": {
            "type": "string",
            "format": "date",
            "title": "Competencia",
            "description": "Primeiro dia do mês do vencimento."
          },
          "data_fechamento": {
            "type": "string",
            "format": "date",
            "title": "Data Fechamento"
          },
          "data_vencimento": {
            "type": "string",
            "format": "date",
            "title": "Data Vencimento"
          }
        },
        "type": "object",
        "required": [
          "competencia",
          "data_fechamento",
          "data_vencimento"
        ],
        "title": "DatasFaturaSaida",
        "description": "Competência e datas efetivas de uma fatura (ajustadas para dia útil)."
      },
      "ErroCampo": {
        "properties": {
          "campo": {
            "type": "string",
            "title": "Campo"
          },
          "mensagem": {
            "type": "string",
            "title": "Mensagem"
          }
        },
        "type": "object",
        "required": [
          "campo",
          "mensagem"
        ],
        "title": "ErroCampo"
      },
      "FaturaResumo": {
        "properties": {
          "competencia": {
            "type": "string",
            "format": "date",
            "title": "Competencia",
            "description": "Primeiro dia do mês do vencimento."
          },
          "data_fechamento": {
            "type": "string",
            "format": "date",
            "title": "Data Fechamento"
          },
          "data_vencimento": {
            "type": "string",
            "format": "date",
            "title": "Data Vencimento"
          },
          "status": {
            "$ref": "#/components/schemas/StatusFatura",
            "description": "Aberta antes do fechamento; fechada a partir dele."
          },
          "valor": {
            "type": "string",
            "format": "decimal",
            "title": "Valor",
