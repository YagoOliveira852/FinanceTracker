# Copie para backend/.env e preencha. Nunca commite o .env.
# Variáveis de ambiente do sistema têm prioridade sobre este arquivo.

# Mesma senha do POSTGRES_PASSWORD do .env da raiz.
# 127.0.0.1 e não localhost: no Windows, localhost tenta IPv6 primeiro e a porta
# do compose só escuta em IPv4 — cada conexão travaria ~20 s antes de cair no IPv4.
DATABASE_URL=postgresql+psycopg://financas:troque-esta-senha@127.0.0.1:5432/financas

# Assina os access tokens (JWT). 32+ caracteres aleatórios; gere com:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar o segredo invalida os access tokens emitidos (o app faz login de novo).
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
# Validade dos tokens (opcional; os valores abaixo são os padrões).
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=30

# Fuso das datas de negócio ("hoje", data local das transações). Opcional; o padrão é este.
TZ_NEGOCIO=America/Fortaleza
